# Фрагмент для server { } optimization-urban.ru (HTTPS).
# Проксирует API на FastAPI (docker compose, порт 8000 на том же сервере).
# После правок: sudo nginx -t && sudo systemctl reload nginx

    location /route/ {
        proxy_pass http://127.0.0.1:8000/route/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /geocode {
        proxy_pass http://127.0.0.1:8000/geocode;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /generate {
        proxy_pass http://127.0.0.1:8000/generate;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
    }
